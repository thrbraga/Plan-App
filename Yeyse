        function addSavingsRecord(e) {
            e.preventDefault();
            const type = document.getElementById('sav-type').value;
            const amount = parseFloat(document.getElementById('sav-amount').value);
            const note = document.getElementById('sav-note').value.trim();

            if (isNaN(amount) || !note) return;

            const date = state.currentDate;
            if (type === 'deposit') {
                state.savings.current += amount;
            } else {
                state.savings.current -= amount;
            }

            state.savings.history.push({ id: Date.now().toString(), type, amount, date, note });
            document.getElementById('sav-amount').value = '';
            document.getElementById('sav-note').value = '';
            saveState();
            renderFinanceiro();
            showToast('Poupança atualizada!');
        }

