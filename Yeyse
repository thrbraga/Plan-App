            Object.values(state.studyLogs).forEach(log => {
                totalMinutes += (log.hours || 0) * 60 + (log.minutes || 0);
                totalQ += log.totalQuestions || 0;
                totalCorrect += log.correctQuestions || 0;
            });

            const totalHoursDecimal = totalMinutes / 60;
            let avgAcc = totalQ > 0 ? (totalCorrect / totalQ) * 100 : 0;

            document.getElementById('stat-total-hours').textContent = totalHoursDecimal.toFixed(1) + 'h';
            document.getElementById('stat-avg-accuracy').textContent = avgAcc.toFixed(1) + '%';
            document.getElementById('stat-total-habits').textContent = state.habits.length;

            let totalInc = 0;
            let totalExp = 0;
            state.transactions.forEach(t => {
                if (t.type === 'income') totalInc += t.amount;
                else totalExp += t.amount;
            });
            document.getElementById('stat-net-balance').textContent = formatCurrency(totalInc - totalExp);
