    <footer class="mt-auto border-t border-black/[0.06] dark:border-white/[0.08] py-4 text-center text-xs text-slate-400">
        <p>Plan &bull; Minimalista & Objetivo &bull; Feito para Arthur</p>
    </footer>

    <!-- JavaScript Application Logic -->
    <script>
        // Financial Categories Predefined
        const FINANCIAL_CATEGORIES = {
            income: ['Salário', 'Freelance', 'Investimentos', 'Família', 'Rendimentos', 'Outros'],
            expense: ['Alimentação', 'Moradia', 'Estudos', 'Transporte', 'Lazer', 'Saúde', 'Vestuário', 'Contas', 'Assinaturas', 'Desejos', 'Família', 'Outros']
        };

        // State Management
        let state = {
            theme: 'light',
            currentDate: new Date().toISOString().split('T')[0],
            selectedFinanceMonth: new Date().toISOString().slice(0, 7), // YYYY-MM
            customGreeting: 'Foco na vaga de Medicina hoje.',
            tasks: [], 
            habits: [],
            habitLogs: {}, 
            studyLogs: {}, 
            journalLogs: {}, 
            projects: [], 
            countdowns: [], 
            transactions: [], 
            savings: { current: 0, history: [] }, 
            projections: [] 
        };

        const STORAGE_KEY = 'plan_app_arthur_v4';
        let expenseChartInstance = null;

        function loadState() {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                try {
                    state = JSON.parse(saved);
                    if (!state.currentDate) state.currentDate = new Date().toISOString().split('T')[0];
                    if (!state.selectedFinanceMonth) state.selectedFinanceMonth = new Date().toISOString().slice(0, 7);
                } catch (e) {
                    console.error('Erro ao carregar dados', e);
                }
            } else {
                const today = new Date().toISOString().split('T')[0];
                state.currentDate = today;
                state.selectedFinanceMonth = today.slice(0, 7);
                state.tasks = [
                    { id: '1', text: 'Estudar Fisiologia Cardiovascular', date: today, completed: true },
                    { id: '2', text: 'Fazer 40 questões de Física Mecânica', date: today, completed: false }
                ];
                state.habits = [
                    { id: 'h1', name: 'Acordar às 06:00', days: [1, 2, 3, 4, 5, 6, 0] },
                    { id: 'h2', name: 'Simulado de Redação', days: [6] }
                ];
                state.countdowns = [
                    { id: 'c1', title: 'Vestibular Medicina 1ª Fase', date: '2026-11-15' }
                ];
                state.projects = [
                    {
                        id: 'p1',
                        title: 'Aprovação Medicina - Revisão Geral',
                        startDate: '2026-03-01',
                        endDate: '2026-11-30',
                        checklist: [
                            { id: 'cl1', text: 'Completar cursinho de Química Orgânica', completed: true },
                            { id: 'cl2', text: 'Zerar banco de questões', completed: false }
                        ],
                        archived: false
                    }
                ];
                state.transactions = [
                    { id: 't1', type: 'income', category: 'Investimentos', amount: 2500, date: today },
                    { id: 't2', type: 'expense', category: 'Estudos', amount: 350, date: today },
                    { id: 't3', type: 'expense', category: 'Alimentação', amount: 120, date: today }
                ];
                state.savings = {
                    current: 1200,
                    history: [
                        { id: 's1', type: 'deposit', amount: 300, date: today, note: 'Reserva do mês' }
                    ]
                };
                state.projections = [
                    { id: 'pr1', type: 'expense', category: 'Estudos', amount: 850, date: `${state.selectedFinanceMonth}-25`, executed: false }
                ];
                saveState();
            }
            applyTheme();
        }

        function saveState() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        }

        // Toast Notification
        function showToast(message) {
            const toast = document.getElementById('toast');
            const msgEl = document.getElementById('toast-message');
            msgEl.textContent = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // Custom Modal
        let modalCallback = null;
        function showModal(title, desc, onConfirm) {
            document.getElementById('modal-title').textContent = title;
            document.getElementById('modal-desc').textContent = desc;
            modalCallback = onConfirm;
            document.getElementById('custom-modal').classList.remove('hidden');
        }

        document.getElementById('modal-cancel').addEventListener('click', () => {
            document.getElementById('custom-modal').classList.add('hidden');
            modalCallback = null;
        });

        document.getElementById('modal-confirm').addEventListener('click', () => {
            if (modalCallback) modalCallback();
            document.getElementById('custom-modal').classList.add('hidden');
            modalCallback = null;
        });

        // Edit Generic Modal Handler
        let currentEditCallback = null;
        function openEditModal(title, bodyHTML, onSave) {
            document.getElementById('edit-modal-title').textContent = title;
            document.getElementById('edit-modal-body').innerHTML = bodyHTML;
            currentEditCallback = onSave;
            document.getElementById('edit-modal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('edit-modal').classList.add('hidden');
            currentEditCallback = null;
        }

        document.getElementById('edit-modal-save-btn').addEventListener('click', () => {
            if (currentEditCallback) {
                currentEditCallback();
            }
            closeEditModal();
        });

        // Theme Toggle
        function applyTheme() {
            if (state.theme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        }

        function toggleTheme() {
            state.theme = state.theme === 'light' ? 'dark' : 'light';
            applyTheme();
            saveState();
            renderExpenseChart();
        }

        // Tab Navigation Logic
        function switchTab(tabId) {
            const tabs = ['hoje', 'projetos', 'financeiro', 'estatisticas'];
            tabs.forEach(t => {
                document.getElementById(`tab-${t}`).classList.add('hidden');
                const btn = document.getElementById(`nav-${t}`);
                if (btn) {
                    btn.classList.remove('bg-white', 'dark:bg-[#2c2c2e]', 'text-[#1d1d1f]', 'dark:text-white', 'shadow-sm');
                    btn.classList.add('text-slate-500', 'dark:text-slate-400');
                }
                const mobBtn = document.getElementById(`mob-nav-${t}`);
                if (mobBtn) {
                    mobBtn.classList.remove('text-[#0071E3]', 'dark:text-white');
                    mobBtn.classList.add('text-slate-400');
                }
            });

            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`nav-${tabId}`);
            if (activeBtn) {
                activeBtn.classList.add('bg-white', 'dark:bg-[#2c2c2e]', 'text-[#1d1d1f]', 'dark:text-white', 'shadow-sm');
                activeBtn.classList.remove('text-slate-500', 'dark:text-slate-400');
            }
            const activeMobBtn = document.getElementById(`mob-nav-${tabId}`);
            if (activeMobBtn) {
                activeMobBtn.classList.add('text-[#0071E3]', 'dark:text-white');
                activeMobBtn.classList.remove('text-slate-400');
            }

            renderAll();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Category dropdown updater
        function updateCategoryDropdown(selectTypeId, selectCatId, selectedVal = '') {
            const typeEl = document.getElementById(selectTypeId);
            const catEl = document.getElementById(selectCatId);
            if (!typeEl || !catEl) return;
            const typeVal = typeEl.value;
            catEl.innerHTML = '';
            const cats = FINANCIAL_CATEGORIES[typeVal] || [];
            cats.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c;
                opt.textContent = c;
                if (c === selectedVal) opt.selected = true;
                catEl.appendChild(opt);
            });
        }

        // ================= TAB 1 RENDER & ACTIONS =================
        function navigateDate(days) {
            const d = new Date(state.currentDate + 'T00:00:00');
            d.setDate(d.getDate() + days);
            state.currentDate = d.toISOString().split('T')[0];
            saveState();
            renderHoje();
        }

        function goToToday() {
            state.currentDate = new Date().toISOString().split('T')[0];
            saveState();
            renderHoje();
        }

        function onDateInputChanged(input) {
            if (input.value) {
                state.currentDate = input.value;
                saveState();
                renderHoje();
            }
        }

        function getDayOfWeekForDate(dateStr) {
            const d = new Date(dateStr + 'T00:00:00');
            return d.getDay();
        }

        function renderHoje() {
            const picker = document.getElementById('date-picker-input');
            if (picker) picker.value = state.currentDate;

            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const dateObj = new Date(state.currentDate + 'T00:00:00');
            const dateFormatted = dateObj.toLocaleDateString('pt-BR', options);
            document.getElementById('current-date-badge').textContent = dateFormatted.charAt(0).toUpperCase() + dateFormatted.slice(1);
            document.getElementById('task-date-label').textContent = dateObj.toLocaleDateString('pt-BR');

            const daysNames = ['Domingo', 'Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira', 'Sábado'];
            const dow = getDayOfWeekForDate(state.currentDate);
            document.getElementById('today-day-name').textContent = daysNames[dow];

            // Dynamic custom greeting
            document.getElementById('dynamic-greeting').textContent = `Olá, Arthur! ${state.customGreeting || 'Foco nos objetivos de hoje.'}`;
            document.getElementById('custom-greeting-input').value = state.customGreeting || '';

            // Countdown Widget
            if (state.countdowns.length > 0) {
                const sorted = [...state.countdowns].sort((a,b) => new Date(a.date) - new Date(b.date));
                const nextEvent = sorted[0];
                document.getElementById('countdown-event-title').textContent = nextEvent.title;
                document.getElementById('countdown-event-date').textContent = new Date(nextEvent.date + 'T00:00:00').toLocaleDateString('pt-BR');
                
                const diffTime = new Date(nextEvent.date + 'T00:00:00') - new Date(new Date().toDateString());
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                document.getElementById('countdown-days-number').textContent = diffDays >= 0 ? diffDays : 0;
            } else {
                document.getElementById('countdown-event-title').textContent = 'Nenhum evento';
                document.getElementById('countdown-event-date').textContent = '--/--/----';
                document.getElementById('countdown-days-number').textContent = '0';
            }

            // Tasks List for selected date
            const selDate = state.currentDate;
            const dateTasks = state.tasks.filter(t => t.date === selDate);
            const tasksListEl = document.getElementById('tasks-list');
            tasksListEl.innerHTML = '';
            let completedCount = 0;

            if (dateTasks.length === 0) {
                tasksListEl.innerHTML = '<p class="text-xs text-slate-400 text-center py-4">Nenhuma tarefa para esta data.</p>';
            } else {
                dateTasks.forEach(t => {
                    if (t.completed) completedCount++;
                    const div = document.createElement('div');
                    div.className = `flex items-center justify-between p-3 rounded-2xl border transition-colors ${t.completed ? 'bg-black/[0.01] dark:bg-white/[0.02] border-transparent opacity-60' : 'bg-black/[0.02] dark:bg-white/[0.04] border-transparent'}`;
                    div.innerHTML = `
                        <label class="flex items-center space-x-3 cursor-pointer flex-1 mr-2">
                            <input type="checkbox" ${t.completed ? 'checked' : ''} onchange="toggleTask('${t.id}')" class="rounded w-4 h-4 text-slate-900 dark:text-white">
                            <span class="text-xs font-medium ${t.completed ? 'line-through text-slate-400' : ''}">${escapeHTML(t.text)}</span>
                        </label>
                        <div class="flex items-center space-x-1">
                            <button onclick="openEditTaskModal('${t.id}')" class="text-slate-400 hover:text-[#0071E3] p-1"><i data-lucide="edit-2" class="w-3.5 h-3.5"></i></button>
                            <button onclick="deleteTask('${t.id}')" class="text-slate-400 hover:text-red-500 p-1"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
                        </div>
                    `;
                    tasksListEl.appendChild(div);
                });
            }
            document.getElementById('today-tasks-counter').textContent = `${completedCount}/${dateTasks.length} tarefas concluídas`;

            // Habits for selected date DOW
            const targetDow = getDayOfWeekForDate(selDate);
            const targetHabits = state.habits.filter(h => h.days.includes(targetDow));
            if (!state.habitLogs[selDate]) state.habitLogs[selDate] = {};

            const habitsListEl = document.getElementById('today-habits-list');
            habitsListEl.innerHTML = '';
            let completedHabitsCount = 0;

            if (targetHabits.length === 0) {
                habitsListEl.innerHTML = '<p class="text-xs text-slate-400 text-center py-4">Nenhum hábito programado para este dia.</p>';
            } else {
                targetHabits.forEach(h => {
                    const isDone = state.habitLogs[selDate][h.id] || false;
                    if (isDone) completedHabitsCount++;
                    const div = document.createElement('div');
                    div.className = `flex items-center justify-between p-3 rounded-2xl border transition-colors ${isDone ? 'bg-amber-50/40 dark:bg-amber-950/20 border-amber-200/40' : 'bg-black/[0.02] dark:bg-white/[0.04] border-transparent'}`;
                    div.innerHTML = `
                        <label class="flex items-center space-x-3 cursor-pointer flex-1">
                            <input type="checkbox" ${isDone ? 'checked' : ''} onchange="toggleHabitLog('${h.id}')" class="rounded w-4 h-4 text-amber-600">
                            <span class="text-xs font-semibold ${isDone ? 'line-through text-slate-400' : ''}">${escapeHTML(h.name)}</span>
                        </label>
                        <span class="text-[10px] font-medium px-2.5 py-0.5 rounded-full ${isDone ? 'bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300' : 'bg-black/[0.04] dark:bg-white/[0.08] text-slate-500'}">${isDone ? 'Concluído' : 'Pendente'}</span>
                    `;
                    habitsListEl.appendChild(div);
                });
            }
            document.getElementById('today-habits-counter').textContent = `${completedHabitsCount}/${targetHabits.length} hábitos do dia`;

            // Study Monitor
            if (!state.studyLogs[selDate]) {
                state.studyLogs[selDate] = { hours: 0, minutes: 0, totalQuestions: 0, correctQuestions: 0 };
            }
            const log = state.studyLogs[selDate];
            document.getElementById('study-hours').value = log.hours || '';
            document.getElementById('study-minutes').value = log.minutes || '';
            document.getElementById('study-questions').value = log.totalQuestions || '';
            document.getElementById('study-correct').value = log.correctQuestions || '';
            updateStudyAccuracyDisplay();

            // Journal & Mood
            if (!state.journalLogs[selDate]) {
                state.journalLogs[selDate] = { mood: '', comment: '' };
            }
            const jLog = state.journalLogs[selDate];
            document.getElementById('journal-comment').value = jLog.comment || '';
            updateMoodUI(jLog.mood);

            renderWeeklyMatrix();
            lucide.createIcons();
        }

        function addTask(e) {
            e.preventDefault();
            const input = document.getElementById('new-task-input');
            const text = input.value.trim();
            if (!text) return;
            state.tasks.push({ id: Date.now().toString(), text, date: state.currentDate, completed: false });
            input.value = '';
            saveState();
            renderHoje();
            showToast('Tarefa adicionada!');
        }

        function toggleTask(id) {
            const task = state.tasks.find(t => t.id === id);
            if (task) {
                task.completed = !task.completed;
                saveState();
                renderHoje();
            }
        }

        function openEditTaskModal(id) {
            const task = state.tasks.find(t => t.id === id);
            if (!task) return;
            const html = `
                <div class="space-y-1">
                    <label class="text-[10px] font-medium text-slate-400 uppercase">Texto da Tarefa</label>
                    <input type="text" id="edit-task-text" value="${escapeHTML(task.text)}" class="w-full bg-black/[0.03] dark:bg-white/[0.06] border border-transparent rounded-xl px-3 py-2 text-xs focus:outline-none">
                </div>
                <div class="space-y-1">
                    <label class="text-[10px] font-medium text-slate-400 uppercase">Data</label>
                    <input type="date" id="edit-task-date" value="${task.date}" class="w-full bg-black/[0.03] dark:bg-white/[0.06] border border-transparent rounded-xl px-3 py-2 text-xs focus:outline-none">
                </div>
            `;
            openEditModal('Editar Tarefa', html, () => {
                const newText = document.getElementById('edit-task-text').value.trim();
                const newDate = document.getElementById('edit-task-date').value;
                if (newText && newDate) {
                    task.text = newText;
                    task.date = newDate;
