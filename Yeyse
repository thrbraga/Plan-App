        function renderFinanceiro() {
            const monthInput = document.getElementById('finance-month-input');
            if (monthInput) monthInput.value = state.selectedFinanceMonth;

            const selectedYM = state.selectedFinanceMonth; // e.g. "2026-11"

            // Filter transactions for selected month
            const monthTransactions = state.transactions.filter(t => t.date && t.date.startsWith(selectedYM));
            let monthIncome = 0;
            let monthExpense = 0;
            monthTransactions.forEach(t => {
                if (t.type === 'income') monthIncome += t.amount;
                else monthExpense += t.amount;
            });
            const monthBalance = monthIncome - monthExpense;

            const balanceEl = document.getElementById('fin-month-balance');
            balanceEl.textContent = formatCurrency(monthBalance);
            balanceEl.className = `text-2xl font-bold mt-1 ${monthBalance >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400'}`;

            document.getElementById('fin-savings').textContent = formatCurrency(state.savings.current);
            
            const monthProjections = state.projections.filter(p => p.date && p.date.startsWith(selectedYM));
            document.getElementById('fin-pending-proj').textContent = monthProjections.filter(p => !p.executed).length;

            updateCategoryDropdown('tx-type', 'tx-category');
            updateCategoryDropdown('proj-type', 'proj-category');

            // Transactions list for selected month
            const txListEl = document.getElementById('transactions-list');
            txListEl.innerHTML = '';
            if (monthTransactions.length === 0) {
                txListEl.innerHTML = '<p class="text-xs text-slate-400 text-center py-4">Nenhuma transação neste mês.</p>';
            } else {
                monthTransactions.sort((a,b) => new Date(b.date) - new Date(a.date)).forEach(t => {
                    const isInc = t.type === 'income';
                    const div = document.createElement('div');
                    div.className = 'flex items-center justify-between p-3 rounded-2xl bg-black/[0.02] dark:bg-white/[0.03] text-xs';
