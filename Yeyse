        function updateMoodUI(currentEmoji) {
            const buttons = document.querySelectorAll('.mood-btn');
            buttons.forEach(btn => {
                const emojiSpan = btn.querySelector('span');
                if (emojiSpan.textContent === currentEmoji) {
                    btn.classList.add('border-[#0071E3]', 'bg-blue-50/50', 'dark:bg-blue-950/30');
                } else {
                    btn.classList.remove('border-[#0071E3]', 'bg-blue-50/50', 'dark:bg-blue-950/30');
