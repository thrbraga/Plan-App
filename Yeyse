        // ================= IMPORT HANDLER =================
        function importDataJSON(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(event) {
                try {
                    const parsed = JSON.parse(event.target.result);
                    if (parsed && typeof parsed === 'object') {
                        if (parsed.tasks) state.tasks = parsed.tasks;
                        if (parsed.habits) state.habits = parsed.habits;
                        if (parsed.habitLogs) state.habitLogs = parsed.habitLogs;

                        if (parsed.studyLogs) {
                            state.studyLogs = parsed.studyLogs;
                        } else if (parsed.studies && Array.isArray(parsed.studies)) {
                            state.studyLogs = {};
                            parsed.studies.forEach(s => {
                                state.studyLogs[s.date] = {
                                    hours: s.hours || 0,
                                    minutes: s.minutes || 0,
                                    totalQuestions: s.questions || s.totalQuestions || 0,
                                    correctQuestions: s.correct || s.correctQuestions || 0
                                };
                            });
                        }

                        if (parsed.journalLogs) {
                            state.journalLogs = parsed.journalLogs;
                        } else if (parsed.dayLogs && Array.isArray(parsed.dayLogs)) {
                            state.journalLogs = {};
                            parsed.dayLogs.forEach(d => {
                                state.journalLogs[d.date] = {
                                    mood: d.mood || '',
                                    comment: d.comment || ''
                                };
                            });
                        }

                        if (parsed.projects) {
                            state.projects = parsed.projects.map(p => ({
                                id: p.id || String(Math.random()),
                                title: p.title || 'Projeto',
                                startDate: p.startDate || new Date().toISOString().split('T')[0],
                                endDate: p.endDate || new Date().toISOString().split('T')[0],
                                checklist: (p.checklist || []).map(cl => ({
                                    id: cl.id || String(Math.random()),
                                    text: cl.text || cl,
                                    completed: cl.done !== undefined ? cl.done : (cl.completed || false)
                                })),
                                archived: p.archived || false
                            }));
                        }
                        if (parsed.archivedProjects && Array.isArray(parsed.archivedProjects)) {
                            parsed.archivedProjects.forEach(ap => {
                                ap.archived = true;
                                state.projects.push(ap);
                            });
                        }

                        if (parsed.countdowns) {
                            state.countdowns = parsed.countdowns;
                        } else if (parsed.events && Array.isArray(parsed.events)) {
                            state.countdowns = parsed.events;
                        }

                        if (parsed.transactions) {
                            state.transactions = parsed.transactions;
                        } else if (parsed.cashFlow && Array.isArray(parsed.cashFlow)) {
                            state.transactions = parsed.cashFlow.map(cf => ({
                                id: cf.id || String(Math.random()),
                                type: cf.type || 'expense',
                                category: cf.category || 'Outros',
                                amount: Number(cf.amount) || 0,
                                date: cf.date || new Date().toISOString().split('T')[0]
                            }));
                        }

                        if (parsed.savings) {
                            if (Array.isArray(parsed.savings)) {
                                let totalSav = 0;
                                let hist = [];
                                parsed.savings.forEach(s => {
                                    totalSav += Number(s.amount) || 0;
                                    hist.push({
                                        id: s.id || String(Math.random()),
                                        type: s.type === 'entry' ? 'deposit' : (s.type || 'deposit'),
                                        amount: Number(s.amount) || 0,
                                        date: s.date || new Date().toISOString().split('T')[0],
                                        note: s.description || 'Aporte'
                                    });
                                });
                                state.savings = { current: totalSav, history: hist };
                            } else {
                                state.savings = parsed.savings;
                            }
                        }

                        if (parsed.projections && Array.isArray(parsed.projections)) {
                            state.projections = parsed.projections.map(pr => ({
                                id: pr.id || String(Math.random()),
                                type: pr.type || 'expense',
                                category: pr.category || 'Outros',
                                amount: Number(pr.amount) || 0,
                                date: pr.date || new Date().toISOString().split('T')[0],
                                executed: pr.executed || false
                            }));
                        }

                        if (parsed.settings) {
                            if (parsed.settings.theme) state.theme = parsed.settings.theme;
                            if (parsed.settings.greeting) state.customGreeting = parsed.settings.greeting;
                        }
                        if (parsed.customGreeting) state.customGreeting = parsed.customGreeting;
                        if (parsed.theme) state.theme = parsed.theme;

                        saveState();
                        applyTheme();
                        renderAll();
                        showToast('Backup importado com sucesso! Dados atualizados.');
                    } else {
                        showToast('Arquivo JSON inválido.');
                    }
                } catch (err) {
                    console.error(err);
                    showToast('Erro ao processar o arquivo JSON.');
                }
            };
            reader.readAsText(file);
        }

        function escapeHTML(str) {
            return str.replace(/[&<>'"]/g, 
                tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
            );
        }

        function renderAll() {
            renderHoje();
            renderProjetos();
            renderFinanceiro();
            renderEstatisticas();
        }

        window.onload = function() {
            loadState();
            renderAll();
            lucide.createIcons();
        };
    </script>
</body>
</html>
