<!DOCTYPE html>
<html lang="pt-BR" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Plan. | Minimalista & Objetivo</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, sans-serif],
                    },
                    colors: {
                        apple: {
                            blue: '#0071E3',
                            blueHover: '#0077ED',
                            bgLight: '#fbfbfd',
                            bgDark: '#000000',
                            cardLight: '#ffffff',
                            cardDark: '#1c1c1e',
                            borderLight: 'rgba(0, 0, 0, 0.06)',
                            borderDark: 'rgba(255, 255, 255, 0.1)'
                        }
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Chart.js for Financial Expenses Breakdown -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.15); border-radius: 9999px; }
        .dark ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); }
    </style>
</head>
<body class="bg-[#fbfbfd] dark:bg-[#000000] text-[#1d1d1f] dark:text-[#f5f5f7] min-h-screen transition-colors duration-300 flex flex-col">

    <!-- Custom Notification Toast -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-[#1d1d1f] text-white dark:bg-[#f5f5f7] dark:text-[#1d1d1f] px-4 py-3 rounded-2xl shadow-2xl flex items-center space-x-3 text-xs font-medium backdrop-blur-xl">
        <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i>
        <span id="toast-message">Ação realizada com sucesso!</span>
    </div>

    <!-- Custom Modal for Confirmations -->
    <div id="custom-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-md hidden">
        <div class="bg-white dark:bg-[#1c1c1e] border border-black/[0.08] dark:border-white/[0.1] rounded-3xl p-6 max-w-sm w-full mx-4 shadow-2xl space-y-4">
            <h3 id="modal-title" class="text-base font-semibold">Confirmação</h3>
            <p id="modal-desc" class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Deseja realmente prosseguir?</p>
            <div class="flex justify-end space-x-2 pt-2">
                <button id="modal-cancel" class="px-4 py-2 text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/10 rounded-xl transition-colors">Cancelar</button>
                <button id="modal-confirm" class="px-4 py-2 text-xs font-medium bg-[#0071E3] text-white rounded-xl hover:opacity-90 transition-opacity">Confirmar</button>
            </div>
        </div>
    </div>

    <!-- Edit Generic Modal -->
    <div id="edit-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-md hidden">
        <div class="bg-white dark:bg-[#1c1c1e] border border-black/[0.08] dark:border-white/[0.1] rounded-3xl p-6 max-w-md w-full mx-4 shadow-2xl space-y-4">
            <div class="flex items-center justify-between">
                <h3 id="edit-modal-title" class="text-base font-semibold">Editar Registro</h3>
                <button onclick="closeEditModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
            </div>
            <div id="edit-modal-body" class="space-y-3">
                <!-- Dynamic form fields -->
            </div>
            <div class="flex justify-end space-x-2 pt-2">
                <button onclick="closeEditModal()" class="px-4 py-2 text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/10 rounded-xl transition-colors">Cancelar</button>
                <button id="edit-modal-save-btn" class="px-4 py-2 text-xs font-medium bg-[#0071E3] text-white rounded-xl hover:opacity-90 transition-opacity">Salvar Alterações</button>
            </div>
        </div>
    </div>

    <!-- Header / Navbar (Apple Cupertino Glass) -->
    <header class="border-b border-black/[0.06] dark:border-white/[0.08] bg-white/80 dark:bg-[#000000]/80 backdrop-blur-2xl sticky top-0 z-40">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
            <div class="flex items-center space-x-2.5">
                <div class="w-7 h-7 rounded-xl bg-[#0071E3] text-white flex items-center justify-center font-semibold text-xs tracking-tight shadow-sm">
                    P
                </div>
                <h1 class="font-semibold text-sm tracking-tight">Plan</h1>
            </div>

            <!-- Desktop Navigation -->
            <nav class="hidden md:flex space-x-1 bg-black/[0.04] dark:bg-white/[0.06] p-1 rounded-xl border border-black/[0.04] dark:border-white/[0.06]">
                <button onclick="switchTab('hoje')" id="nav-hoje" class="tab-btn px-3.5 py-1.5 text-xs font-medium rounded-lg transition-all duration-200 flex items-center space-x-1.5 bg-white dark:bg-[#2c2c2e] text-[#1d1d1f] dark:text-white shadow-sm">
                    <i data-lucide="sun" class="w-3.5 h-3.5"></i>
                    <span>Hoje</span>
                </button>
                <button onclick="switchTab('projetos')" id="nav-projetos" class="tab-btn px-3.5 py-1.5 text-xs font-medium rounded-lg transition-all duration-200 flex items-center space-x-1.5 text-slate-500 dark:text-slate-400 hover:text-[#1d1d1f] dark:hover:text-white">
                    <i data-lucide="layers" class="w-3.5 h-3.5"></i>
                    <span>Projetos & Hábitos</span>
                </button>
                <button onclick="switchTab('financeiro')" id="nav-financeiro" class="tab-btn px-3.5 py-1.5 text-xs font-medium rounded-lg transition-all duration-200 flex items-center space-x-1.5 text-slate-500 dark:text-slate-400 hover:text-[#1d1d1f] dark:hover:text-white">
                    <i data-lucide="credit-card" class="w-3.5 h-3.5"></i>
                    <span>Financeiro</span>
                </button>
                <button onclick="switchTab('estatisticas')" id="nav-estatisticas" class="tab-btn px-3.5 py-1.5 text-xs font-medium rounded-lg transition-all duration-200 flex items-center space-x-1.5 text-slate-500 dark:text-slate-400 hover:text-[#1d1d1f] dark:hover:text-white">
                    <i data-lucide="sliders" class="w-3.5 h-3.5"></i>
                    <span>Ajustes</span>
                </button>
            </nav>

            <div class="flex items-center space-x-2">
                <button onclick="toggleTheme()" class="p-2 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-black/[0.04] dark:hover:bg-white/[0.08] transition-colors" title="Alternar Tema">
                    <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
                    <i data-lucide="moon" class="w-4 h-4 block dark:hidden"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation -->
        <div class="md:hidden flex border-t border-black/[0.06] dark:border-white/[0.08] bg-white/90 dark:bg-[#000000]/90 backdrop-blur-xl px-2 py-1 justify-around">
            <button onclick="switchTab('hoje')" id="mob-nav-hoje" class="mob-tab flex flex-col items-center py-1 px-3 text-[10px] font-medium text-[#0071E3]">
                <i data-lucide="sun" class="w-4 h-4 mb-0.5"></i>
                <span>Hoje</span>
            </button>
            <button onclick="switchTab('projetos')" id="mob-nav-projetos" class="mob-tab flex flex-col items-center py-1 px-3 text-[10px] font-medium text-slate-400">
                <i data-lucide="layers" class="w-4 h-4 mb-0.5"></i>
                <span>Projetos</span>
            </button>
            <button onclick="switchTab('financeiro')" id="mob-nav-financeiro" class="mob-tab flex flex-col items-center py-1 px-3 text-[10px] font-medium text-slate-400">
                <i data-lucide="credit-card" class="w-4 h-4 mb-0.5"></i>
                <span>Financeiro</span>
            </button>
            <button onclick="switchTab('estatisticas')" id="mob-nav-estatisticas" class="mob-tab flex flex-col items-center py-1 px-3 text-[10px] font-medium text-slate-400">
                <i data-lucide="sliders" class="w-4 h-4 mb-0.5"></i>
                <span>Ajustes</span>
            </button>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 space-y-6">

        <!-- ================= TAB 1: HOJE ================= -->
        <div id="tab-hoje" class="tab-content space-y-6">
            
            <!-- Date Navigation Header & Greeting Banner -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                <div class="lg:col-span-2 bg-white dark:bg-[#1c1c1e] border border-black/[0.06] dark:border-white/[0.08] p-6 rounded-3xl shadow-[0_4px_24px_rgba(0,0,0,0.02)] flex flex-col justify-between relative overflow-hidden">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-black/[0.04] dark:border-white/[0.06]">
                        <div class="flex items-center space-x-2">
                            <button onclick="navigateDate(-1)" class="p-2 rounded-xl bg-black/[0.03] dark:bg-white/[0.06] hover:bg-black/[0.06] dark:hover:bg-white/[0.1] transition-colors" title="Dia Anterior">
                                <i data-lucide="chevron-left" class="w-4 h-4"></i>
                            </button>
                            <input type="date" id="date-picker-input" onchange="onDateInputChanged(this)" class="bg-black/[0.03] dark:bg-white/[0.06] border border-transparent rounded-xl px-3 py-1.5 text-xs font-semibold focus:outline-none cursor-pointer">
                            <button onclick="navigateDate(1)" class="p-2 rounded-xl bg-black/[0.03] dark:bg-white/[0.06] hover:bg-black/[0.06] dark:hover:bg-white/[0.1] transition-colors" title="Próximo Dia">
                                <i data-lucide="chevron-right" class="w-4 h-4"></i>
                            </button>
                            <button onclick="goToToday()" class="px-3 py-1.5 bg-[#0071E3]/10 text-[#0071E3] dark:bg-[#0071E3]/20 dark:text-blue-400 rounded-xl text-xs font-medium hover:opacity-80 transition-opacity">
                                Hoje
                            </button>
                        </div>
                        <span id="current-date-badge" class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">--</span>
                    </div>

                    <div class="pt-4">
                        <h2 id="dynamic-greeting" class="text-xl sm:text-2xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">Olá, Arthur! Foco na vaga de Medicina hoje.</h2>
                    </div>

                    <div class="mt-6 flex items-center space-x-3 text-xs text-slate-500 dark:text-slate-400">
                        <div class="flex items-center space-x-1.5 bg-black/[0.03] dark:bg-white/[0.06] px-3 py-1.5 rounded-xl">
                            <i data-lucide="check-circle" class="w-3.5 h-3.5 text-emerald-500"></i>
                            <span id="today-tasks-counter">0/0 tarefas concluídas</span>
                        </div>
                        <div class="flex items-center space-x-1.5 bg-black/[0.03] dark:bg-white/[0.06] px-3 py-1.5 rounded-xl">
                            <i data-lucide="flame" class="w-3.5 h-3.5 text-amber-500"></i>
                            <span id="today-habits-counter">0/0 hábitos do dia</span>
                        </div>
                    </div>
                </div>

                <!-- Countdown Widget -->
                <div class="bg-white dark:bg-[#1c1c1e] border border-black/[0.06] dark:border-white/[0.08] p-6 rounded-3xl shadow-[0_4px_24px_rgba(0,0,0,0.02)] flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-2">
                            <i data-lucide="hourglass" class="w-4 h-4 text-[#0071E3]"></i>
                            <h3 class="font-semibold text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider">Próximo Evento</h3>
                        </div>
                        <span class="text-[11px] text-slate-400" id="countdown-event-date">--/--/----</span>
                    </div>
                    <div class="my-3 text-center">
                        <h4 id="countdown-event-title" class="font-semibold text-sm text-[#1d1d1f] dark:text-white truncate">Nenhum evento</h4>
                        <div class="mt-1.5 flex items-baseline justify-center space-x-1">
                            <span id="countdown-days-number" class="text-3xl font-bold tracking-tight text-[#0071E3]">0</span>
                            <span class="text-[10px] text-slate-400 uppercase tracking-wider font-medium">dias</span>
                        </div>
                    </div>
                    <button onclick="switchTab('projetos')" class="w-full py-2 text-xs font-medium text-[#0071E3] bg-[#0071E3]/10 hover:bg-[#0071E3]/20 rounded-xl transition-colors">
                        Gerenciar Eventos
                    </button>
                </div>
            </div>

            <!-- Main Grid Today -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                
                <!-- Left Subcolumn: Tasks & Habits -->
                <div class="space-y-6">
                    
                    <!-- Tarefas do Dia -->
                    <div class="bg-white dark:bg-[#1c1c1e] border border-black/[0.06] dark:border-white/[0.08] rounded-3xl p-6 shadow-[0_4px_24px_rgba(0,0,0,0.02)] space-y-4">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-2">
                                <i data-lucide="check-square" class="w-4 h-4 text-emerald-500"></i>
                                <h3 class="font-semibold text-sm">Tarefas do Dia</h3>
                            </div>
                            <span class="text-[11px] text-slate-400" id="task-date-label">Selecionada</span>
                        </div>
                        
                        <form onsubmit="addTask(event)" class="flex space-x-2">
                            <input type="text" id="new-task-input" placeholder="Adicionar nova tarefa para esta data..." class="flex-1 bg-black/[0.03] dark:bg-white/[0.06] border border-transparent focus:border-black/20 dark:focus:border-white/20 rounded-2xl px-4 py-2.5 text-xs focus:outline-none transition-all">
                            <button type="submit" class="bg-[#1d1d1f] dark:bg-white text-white dark:text-[#1d1d1f] px-4 py-2.5 rounded-2xl font-medium text-xs hover:opacity-90 transition-opacity flex items-center space-x-1">
                                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                                <span>Adicionar</span>
                            </button>
                        </form>

                        <div id="tasks-list" class="space-y-2 max-h-60 overflow-y-auto pr-1">
                            <!-- Tasks populated dynamically -->
                        </div>
                    </div>

                    <!-- Rastrador de Hábitos de Hoje -->
                    <div class="bg-white dark:bg-[#1c1c1e] border border-black/[0.06] dark:border-white/[0.08] rounded-3xl p-6 shadow-[0_4px_24px_rgba(0,0,0,0.02)] space-y-4">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-2">
                                <i data-lucide="repeat" class="w-4 h-4 text-amber-500"></i>
                                <h3 class="font-semibold text-sm">Rastrador de Hábitos</h3>
                            </div>
                            <span id="today-day-name" class="text-[10px] font-medium px-2.5 py-1 rounded-full bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400">Dia Atual</span>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Hábitos programados para este dia:</p>

                        <div id="today-habits-list" class="space-y-2">
                            <!-- Habits populated dynamically -->
                        </div>
                    </div>

                </div>

                <!-- Right Subcolumn: Study Monitor & End of Day Journal -->
                <div class="space-y-6">

                    <!-- Monitor de Estudos -->
                    <div class="bg-white dark:bg-[#1c1c1e] border border-black/[0.06] dark:border-white/[0.08] rounded-3xl p-6 shadow-[0_4px_24px_rgba(0,0,0,0.02)] space-y-4">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-2">
                                <i data-lucide="book-open" class="w-4 h-4 text-[#0071E3]"></i>
                                <h3 class="font-semibold text-sm">Monitor de Estudos</h3>
                            </div>
                            <span class="text-[11px] text-slate-400">Registro Diário</span>
                        </div>

                        <div class="grid grid-cols-4 gap-2.5">
                            <div class="space-y-1">
                                <label class="text-[10px] font-medium text-slate-400 uppercase tracking-wider">Horas</label>
                                <input type="number" min="0" id="study-hours" oninput="saveStudyData()" placeholder="0" class="w-full bg-black/[0.03] dark:bg-white/[0.06] border border-transparent rounded-xl px-2.5 py-2 text-xs text-center font-semibold focus:outline-none focus:ring-1 focus:ring-[#0071E3]">
                            </div>
                            <div class="space-y-1">
                                <label class="text-[10px] font-medium text-slate-400 uppercase tracking-wider">Minutos</label>
                                <input type="number" min="0" max="59" id="study-minutes" oninput="saveStudyData()" placeholder="0" class="w-full bg-black/[0.03] dark:bg-white/[0.06] border border-transparent rounded-xl px-2.5 py-2 text-xs text-center font-semibold focus:outline-none focus:ring-1 focus:ring-[#0071E3]">
                            </div>
                            <div class="space-y-1">
                                <label class="text-[10px] font-medium text-slate-400 uppercase tracking-wider">Q. Feitas</label>
                                <input type="number" min="0" id="study-questions" oninput="saveStudyData()" placeholder="0" class="w-full bg-black/[0.03] dark:bg-white/[0.06] border border-transparent rounded-xl px-2.5 py-2 text-xs text-center font-semibold focus:outline-none focus:ring-1 focus:ring-[#0071E3]">
                            </div>
                            <div class="space-y-1">
                                <label class="text-[10px] font-medium text-slate-400 uppercase tracking-wider">Q. Acertos</label>
                                <input type="number" min="0" id="study-correct" oninput="saveStudyData()" placeholder="0" class="w-full bg-black/[0.03] dark:bg-white/[0.06] border border-transparent rounded-xl px-2.5 py-2 text-xs text-center font-semibold focus:outline-none focus:ring-1 focus:ring-[#0071E3]">
                            </div>
                        </div>

                        <!-- Real-time Accuracy Display -->
                        <div class="bg-blue-50/50 dark:bg-blue-950/20 border border-blue-100 dark:border-blue-900/30 rounded-2xl p-4 flex items-center justify-between">
                            <div>
                                <span class="text-[11px] text-[#0071E3] font-medium">Percentual de Acertos</span>
                                <h4 id="study-accuracy-display" class="text-xl font-bold text-[#0071E3]">0.0%</h4>
                            </div>
                            <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center text-[#0071E3]">
                                <i data-lucide="percent" class="w-5 h-5"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Diário de Bordo (Fim do Dia) -->
                    <div class="bg-white dark:bg-[#1c1c1e] border border-black/[0.06] dark:border-white/[0.08] rounded-3xl p-6 shadow-[0_4px_24px_rgba(0,0,0,0.02)] space-y-4">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-2">
                                <i data-lucide="smile" class="w-4 h-4 text-purple-500"></i>
                                <h3 class="font-semibold text-sm">Diário de Bordo & Humor</h3>
                            </div>
                            <span class="text-[11px] text-slate-400">Revisão Noturna</span>
                        </div>

                        <div class="space-y-2">
                            <label class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Como você avalia seu dia?</label>
                            <div id="mood-selector" class="grid grid-cols-4 gap-2">
                                <button type="button" onclick="setMood('⚡', 'Focado')" class="mood-btn p-2.5 rounded-2xl border border-black/[0.06] dark:border-white/[0.08] hover:bg-black/[0.02] dark:hover:bg-white/[0.04] text-center transition-all flex flex-col items-center">
                                    <span class="text-lg">⚡</span>
                                    <span class="text-[9px] mt-1 font-medium text-slate-600 dark:text-slate-300">Focado</span>
                                </button>
                                <button type="button" onclick="setMood('🧠', 'Produtivo')" class="mood-btn p-2.5 rounded-2xl border border-black/[0.06] dark:border-white/[0.08] hover:bg-black/[0.02] dark:hover:bg-white/[0.04] text-center transition-all flex flex-col items-center">
                                    <span class="text-lg">🧠</span>
                                    <span class="text-[9px] mt-1 font-medium text-slate-600 dark:text-slate-300">Produtivo</span>
                                </button>
                                <button type="button" onclick="setMood('🔋', 'Cansado')" class="mood-btn p-2.5 rounded-2xl border border-black/[0.06] dark:border-white/[0.08] hover:bg-black/[0.02] dark:hover:bg-white/[0.04] text-center transition-all flex flex-col items-center">
                                    <span class="text-lg">🔋</span>
                                    <span class="text-[9px] mt-1 font-medium text-slate-600 dark:text-slate-300">Cansado</span>
                                </button>
                                <button type="button" onclick="setMood('📉', 'Desafiador')" class="mood-btn p-2.5 rounded-2xl border border-black/[0.06] dark:border-white/[0.08] hover:bg-black/[0.02] dark:hover:bg-white/[0.04] text-center transition-all flex flex-col items-center">
                                    <span class="text-lg">📉</span>
                                    <span class="text-[9px] mt-1 font-medium text-slate-600 dark:text-slate-300">Desafiador</span>
                                </button>
                            </div>
                        </div>

                        <div class="space-y-1.5">
                            <label class="text-[11px] font-medium text-slate-500 dark:text-slate-400">O que precisa melhorar?</label>
                            <textarea id="journal-comment" oninput="saveJournalComment()" rows="2" placeholder="Reflexões rápidas sobre pontos de melhoria..." class="w-full bg-black/[0.03] dark:bg-white/[0.06] border border-transparent rounded-2xl p-3 text-xs focus:outline-none transition-all"></textarea>
                        </div>
                    </div>

                </div>

            </div>

            <!-- Planejamento Semanal (Tarefas da semana & Eventos) -->
            <div class="bg-white dark:bg-[#1c1c1e] border border-black/[0.06] dark:border-white/[0.08] rounded-3xl p-6 shadow-[0_4px_24px_rgba(0,0,0,0.02)] space-y-4">
