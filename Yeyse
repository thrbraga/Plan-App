            if (rec) {
                if (rec.type === 'deposit') state.savings.current -= rec.amount;
                else state.savings.current += rec.amount;
                state.savings.history = state.savings.history.filter(s => s.id !== id);
                saveState();
                renderFinanceiro();
                showToast('Registro de poupança removido.');
            }
