                                <button onclick="openEditTransactionModal('${t.id}')" class="text-slate-400 hover:text-[#0071E3] p-1"><i data-lucide="edit-2" class="w-3.5 h-3.5"></i></button>
                                <button onclick="deleteTransaction('${t.id}')" class="text-slate-400 hover:text-red-500 p-1"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
                            </div>
                        </div>
                    `;
                    txListEl.appendChild(div);
                });
