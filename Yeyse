        function renderWeeklyMatrix() {
            const grid = document.getElementById('weekly-matrix-grid');
            grid.innerHTML = '';
            const daysNames = ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'];
            
            const curr = new Date(state.currentDate + 'T00:00:00');
            const first = curr.getDate() - curr.getDay() + 1; // Monday start
            
            for (let i = 0; i < 7; i++) {
                const dayDate = new Date(curr.setDate(first + i));
                const dateStr = dayDate.toISOString().split('T')[0];
                const isSelected = dateStr === state.currentDate;
                
                const dayTasks = state.tasks.filter(t => t.date === dateStr);
                const dayEvents = state.countdowns.filter(c => c.date === dateStr);

                const card = document.createElement('div');
                card.className = `p-3 rounded-2xl border flex flex-col justify-between space-y-2 cursor-pointer transition-colors ${isSelected ? 'border-[#0071E3] bg-blue-50/20 dark:bg-blue-950/10' : 'border-black/[0.06] dark:border-white/[0.08] bg-black/[0.01] dark:bg-white/[0.02]'}`;
                card.onclick = () => {
                    state.currentDate = dateStr;
                    saveState();
                    renderHoje();
                };
                
                let contentHTML = '';
                dayTasks.forEach(t => {
                    contentHTML += `<div class="text-[10px] truncate ${t.completed ? 'line-through text-slate-400' : 'text-slate-700 dark:text-slate-300'}">&bull; ${escapeHTML(t.text)}</div>`;
                });
                dayEvents.forEach(e => {
                    contentHTML += `<div class="text-[10px] font-semibold text-purple-600 dark:text-purple-400">★ ${escapeHTML(e.title)}</div>`;
                });
                if (!contentHTML) {
                    contentHTML = '<span class="text-[10px] text-slate-400 italic">Sem tarefas</span>';
                }

                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold ${isSelected ? 'text-[#0071E3]' : ''}">${daysNames[i]}</span>
                        <span class="text-[10px] text-slate-400">${dayDate.getDate()}/${dayDate.getMonth()+1}</span>
                    </div>
                    <div class="space-y-1 overflow-y-auto max-h-24">
                        ${contentHTML}
                    </div>
                `;
                grid.appendChild(card);
            }
        }

