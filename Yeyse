                                <i data-lucide="${isInc ? 'arrow-down-left' : 'arrow-up-right'}" class="w-3.5 h-3.5"></i>
                            </div>
                            <div>
                                <strong class="font-medium">${escapeHTML(t.category)}</strong>
                                <p class="text-[10px] text-slate-400">${t.date} (${isInc ? 'Receita' : 'Despesa'})</p>
