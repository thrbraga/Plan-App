        function saveStudyData() {
            const selDate = state.currentDate;
            const hours = parseInt(document.getElementById('study-hours').value) || 0;
            const minutes = parseInt(document.getElementById('study-minutes').value) || 0;
            const totalQuestions = parseInt(document.getElementById('study-questions').value) || 0;
            const correctQuestions = parseInt(document.getElementById('study-correct').value) || 0;

            state.studyLogs[selDate] = { hours, minutes, totalQuestions, correctQuestions };
            saveState();
            updateStudyAccuracyDisplay();
        }

        function updateStudyAccuracyDisplay() {
            const selDate = state.currentDate;
            const log = state.studyLogs[selDate] || { totalQuestions: 0, correctQuestions: 0 };
            let pct = 0;
            if (log.totalQuestions > 0) {
                pct = (log.correctQuestions / log.totalQuestions) * 100;
                if (pct > 100) pct = 100;
            }
            document.getElementById('study-accuracy-display').textContent = pct.toFixed(1) + '%';
        }

